<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.songoda</groupId>
    <artifactId>SongodaPluginBOM</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>SongodaPluginBOM</name>
    <description>Shared dependency versions for active Songoda plugins.</description>
    <url>https://github.com/Songoda-Plugins/SongodaCore</url>

    <properties>
        <songoda.core.version>5.0.4-SNAPSHOT</songoda.core.version>
    </properties>

    <distributionManagement>
        <repository>
            <id>songoda-public</id>
            <url>https://repo.songoda-reborn.com/repository/maven-public/</url>
        </repository>
    </distributionManagement>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.songoda</groupId>
                <artifactId>SongodaCore</artifactId>
                <version>${songoda.core.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
